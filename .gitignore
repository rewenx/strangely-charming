# The public tree contains the mod source, build inputs, notices and README artwork.
# Keep development notes, art masters, playtest output and signing files local.
/*
!/.gitignore
!/README.md
!/LICENSE*
!/NOTICE*
!/Cargo.toml
!/Cargo.lock
!/VERSION
!/compatibility.json
!/src/
!/config/
!/content/
!/mixins/
!/art/
/art/*
!/art/st_title_card.png
!/art/portal_biomes.json
!/tools/
/tools/*
!/tools/package.py
!/tools/embed_content.py
!/tools/portal_models.py
!/tools/LICENSE*

.DS_Store
__pycache__/
*.pyc
*.psd
*.aseprite
*.log
*.hnmod
*.minisig
*.key
.env

# The release carries the runtime art for these licensed assets.
/content/assets/strangely_charming/textures/block/amethyst_*.png
/content/assets/strangely_charming/textures/block/runic_amethyst_*.png
/content/assets/strangely_charming/textures/block/*_tombstone.png
/content/assets/strangely_charming/models/block/*_tombstone.json
/mixins/strangely_charming/content_bundle.rs
!/tools/release_art.py
!/tools/release_art.json
